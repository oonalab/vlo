// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`vlo deploy > generates the cloud-run stack > cloud-run/Dockerfile 1`] = `
"# Vlo host image — generated by \`vlo deploy --profile prod\`.
# Build context is the repo root: the image needs the workspace, not just this directory.
#
#   docker build -f deploy/vlo/cloud-run/Dockerfile -t vlo .

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/vlo ./packages/vlo
RUN pnpm install --frozen-lockfile --filter @vlo/sdk...
RUN pnpm --filter @vlo/sdk build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
# The profile decides which modules are loaded; the globs in vlo.config.ts resolve
# against this directory, so everything they can match has to be here.
COPY vlo.config.ts ./
COPY src ./src

ENV VLO_PROFILE=prod
# Cloud Run injects PORT (default 8080) and \`vlo serve\` honours it.
EXPOSE 8080
CMD ["pnpm", "exec", "vlo", "serve", "--profile", "prod"]
"
`;

exports[`vlo deploy > generates the cloud-run stack > cloud-run/README.md 1`] = `
"# Vlo on Cloud Run — \`prod\`

Generated by \`vlo deploy --profile prod\`. Nothing here has been applied.

| File | Goes to | What it is |
| --- | --- | --- |
| \`Dockerfile\` | keep here | Two-stage image; \`CMD\` is \`vlo serve --profile prod\` |
| \`cloudbuild.yaml\` | keep here | build → push → \`gcloud run deploy\`, run by the triggers |
| \`cloud-run-vlo.tf\` | \`terraform/\` | Service, SA, IAM, Secret Manager containers |
| \`cloudbuild-vlo.tf\` | \`terraform/\` | Artifact Registry, deployer SA, per-env triggers |

Envs: staging, prod · region \`europe-west4\` · service \`\${prefix}-vlo\`

## One-time setup

1. **Connect the repo to Cloud Build** — install the Google Cloud Build GitHub App and
   connect the repo under Cloud Build → Repositories (1st gen). Terraform cannot do this,
   and applies fail with "repository mapping does not exist" until it is done.
2. **Copy the Terraform** into the root module: \`cp *.tf ../../../terraform/\`.
3. **Create the secret containers**, then add a version per env. Versions are deliberately
   not in Terraform — a value in state is a value in every plan output:

   \`\`\`bash
   printf '%s' "$DATABASE_URL"    | gcloud secrets versions add vlo-staging-vlo-database-url --data-file=- --project orbi-backup
   printf '%s' "$VLO_TOKEN"       | gcloud secrets versions add vlo-staging-vlo-token --data-file=- --project orbi-backup
   printf '%s' "$VLO_PUSH_SECRET" | gcloud secrets versions add vlo-staging-vlo-push-secret --data-file=- --project orbi-backup
   \`\`\`
   \`\`\`bash
   printf '%s' "$DATABASE_URL"    | gcloud secrets versions add vlo-prod-vlo-database-url --data-file=- --project orbi-backup
   printf '%s' "$VLO_TOKEN"       | gcloud secrets versions add vlo-prod-vlo-token --data-file=- --project orbi-backup
   printf '%s' "$VLO_PUSH_SECRET" | gcloud secrets versions add vlo-prod-vlo-push-secret --data-file=- --project orbi-backup
   \`\`\`
4. \`terraform -chdir=terraform apply\`.
5. Push to \`main\`. Staging builds and deploys; prod waits for approval in the Cloud Build
   console.

## Then

- \`vlo doctor --profile prod\` from a shell with the same env, before the first deploy.
- The service is reachable from the internet and protected by \`VLO_TOKEN\`; put a load
  balancer or IAP in front of it if you need network-level restriction too.
- Rotating a secret is \`gcloud secrets versions add\` plus a revision restart — no apply.
"
`;

exports[`vlo deploy > generates the cloud-run stack > cloud-run/cloud-run-vlo.tf 1`] = `
"// Vlo host on Cloud Run — generated by \`vlo deploy --profile prod\`.
//
// Drop into terraform/ beside cloud-run-video-renderer.tf; this file reuses that module's
// \`local.envs\` (pubsub.tf), \`local.env_buckets\` (storage.tf), \`var.project_id\` and the
// \`google_project_service\` enablements already declared there.

variable "vlo_image" {
  description = "Initial container image. The real image is pushed by the Cloud Build trigger; Terraform ignores later image changes (lifecycle.ignore_changes)."
  type        = string
  default     = "us-docker.pkg.dev/cloudrun/container/hello"
}

variable "vlo_location" {
  description = "Cloud Run region for the Vlo host."
  type        = string
  default     = "europe-west4"
}

variable "vlo_envs" {
  description = "Envs from local.envs the Vlo host is deployed to."
  type        = list(string)
  default     = ["staging", "prod"]
}

locals {
  vlo_envs = { for name, env in local.envs : name => env if contains(var.vlo_envs, name) }
}

// ===========================================================================
// Secrets
// ===========================================================================
//
// First service in this project that needs a database, so the first that needs Secret
// Manager. Terraform declares the secret *containers* only — versions hold the values and
// would land in state, so they are added out of band, once per env:
//
//   printf '%s' "$DATABASE_URL" | gcloud secrets versions add <secret-id> --data-file=-
//
// A service revision resolves "latest" at start-up, so rotating a secret is a new version
// plus a restart, with no Terraform run.

resource "google_secret_manager_secret" "vlo_database_url" {
  for_each = local.vlo_envs

  project   = var.project_id
  secret_id = "\${each.value.prefix}-vlo-database-url"

  replication {
    auto {}
  }
}

resource "google_secret_manager_secret" "vlo_token" {
  for_each = local.vlo_envs

  project   = var.project_id
  secret_id = "\${each.value.prefix}-vlo-token"

  replication {
    auto {}
  }
}

resource "google_secret_manager_secret" "vlo_push_secret" {
  for_each = local.vlo_envs

  project   = var.project_id
  secret_id = "\${each.value.prefix}-vlo-push-secret"

  replication {
    auto {}
  }
}

// ===========================================================================
// Per-env service account (least privilege)
// ===========================================================================

resource "google_service_account" "vlo" {
  for_each = local.vlo_envs

  account_id   = "\${each.value.prefix}-vlo"
  display_name = "Vlo host (\${each.key})"
  description  = "Durable execution host for \${each.key}"
  project      = var.project_id
}

// Blob store: offloaded payloads and checkpoints, in the env's own bucket.
resource "google_storage_bucket_iam_member" "vlo_storage" {
  for_each = local.vlo_envs

  bucket = local.env_buckets[each.key]
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:\${google_service_account.vlo[each.key].email}"
}

resource "google_secret_manager_secret_iam_member" "vlo_database_url" {
  for_each = local.vlo_envs

  project   = var.project_id
  secret_id = google_secret_manager_secret.vlo_database_url[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:\${google_service_account.vlo[each.key].email}"
}

resource "google_secret_manager_secret_iam_member" "vlo_token" {
  for_each = local.vlo_envs

  project   = var.project_id
  secret_id = google_secret_manager_secret.vlo_token[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:\${google_service_account.vlo[each.key].email}"
}

resource "google_secret_manager_secret_iam_member" "vlo_push_secret" {
  for_each = local.vlo_envs

  project   = var.project_id
  secret_id = google_secret_manager_secret.vlo_push_secret[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:\${google_service_account.vlo[each.key].email}"
}

// Structured logs from the dispatcher and the router.
resource "google_project_iam_member" "vlo_log_writer" {
  for_each = local.vlo_envs

  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:\${google_service_account.vlo[each.key].email}"
}

// ===========================================================================
// Cloud Run service
// ===========================================================================

resource "google_cloud_run_v2_service" "vlo" {
  for_each = local.vlo_envs

  name     = "\${each.value.prefix}-vlo"
  location = var.vlo_location
  project  = var.project_id

  template {
    // Long-poll task claims and SSE streams hold a request open; 3600s is the ceiling.
    timeout = "3600s"

    // The host is I/O bound — it waits on Postgres and on worker pushes — so one instance
    // serves many runs.
    max_instance_request_concurrency = 80

    scaling {
      // The dispatcher is a background loop, not a request handler: scaling to zero would
      // stop timers firing and tasks being pushed.
      min_instance_count = 1
      max_instance_count = 3
    }

    service_account = google_service_account.vlo[each.key].email

    containers {
      image = var.vlo_image

      ports {
        container_port = 8080
      }

      resources {
        limits = {
          cpu    = "1"
          memory = "1Gi"
        }
        // The dispatcher ticks between requests, so CPU must not be throttled when idle.
        cpu_idle          = false
        startup_cpu_boost = true
      }

      env {
        name  = "VLO_PROFILE"
        value = "prod"
      }
      env {
        name  = "GCP_PROJECT_ID"
        value = var.project_id
      }
      env {
        name  = "VLO_BUCKET"
        value = local.env_buckets[each.key]
      }

      env {
        name = "DATABASE_URL"
        value_source {
          secret_key_ref {
            secret  = google_secret_manager_secret.vlo_database_url[each.key].secret_id
            version = "latest"
          }
        }
      }
      env {
        name = "VLO_TOKEN"
        value_source {
          secret_key_ref {
            secret  = google_secret_manager_secret.vlo_token[each.key].secret_id
            version = "latest"
          }
        }
      }
      env {
        name = "VLO_PUSH_SECRET"
        value_source {
          secret_key_ref {
            secret  = google_secret_manager_secret.vlo_push_secret[each.key].secret_id
            version = "latest"
          }
        }
      }
    }
  }

  ingress = "INGRESS_TRAFFIC_ALL"

  // The image is deployed by the Cloud Build trigger; without this every apply would roll
  // the running code back to the placeholder.
  lifecycle {
    ignore_changes = [
      client,
      client_version,
      template[0].containers[0].image,
    ]
  }

  depends_on = [
    google_project_service.run,
  ]
}

// Open at the network edge, closed at the app layer: every control-plane route requires the
// bearer token in VLO_TOKEN, and inbound task callbacks are HMAC-signed with VLO_PUSH_SECRET.
// IAM invoker checks cannot be used here because the callers are workers on other platforms
// (Vercel functions, pollers) that hold a Vlo token, not a Google identity.
resource "google_cloud_run_v2_service_iam_member" "vlo_invoker" {
  for_each = local.vlo_envs

  project  = var.project_id
  location = var.vlo_location
  name     = google_cloud_run_v2_service.vlo[each.key].name

  role   = "roles/run.invoker"
  member = "allUsers"
}

output "vlo_urls" {
  description = "Public URL of the Vlo host per env; this is VLO_PUBLIC_URL for its peers."
  value       = { for name, service in google_cloud_run_v2_service.vlo : name => service.uri }
}
"
`;

exports[`vlo deploy > generates the cloud-run stack > cloud-run/cloudbuild.yaml 1`] = `
"# Build + deploy the Vlo host to Cloud Run. Invoked by the per-env Cloud Build
# triggers in cloudbuild-vlo.tf (staging: auto on main; prod: same filter, gated on a
# manual approval). Substitutions:
#   _SERVICE — Cloud Run service name (e.g. vlo-prod-vlo)
#   _REGION  — Cloud Run + Artifact Registry region
#   _REPO    — Artifact Registry docker repo name
steps:
  - id: build
    name: gcr.io/cloud-builders/docker
    args:
      - build
      - -f
      - deploy/vlo/cloud-run/Dockerfile
      - -t
      - \${_REGION}-docker.pkg.dev/\${PROJECT_ID}/\${_REPO}/vlo:\${SHORT_SHA}
      - -t
      - \${_REGION}-docker.pkg.dev/\${PROJECT_ID}/\${_REPO}/vlo:latest
      - .

  - id: push
    name: gcr.io/cloud-builders/docker
    args:
      - push
      - --all-tags
      - \${_REGION}-docker.pkg.dev/\${PROJECT_ID}/\${_REPO}/vlo

  - id: deploy
    name: gcr.io/google.com/cloudsdktool/cloud-sdk:slim
    entrypoint: gcloud
    args:
      - run
      - deploy
      - \${_SERVICE}
      - --image
      - \${_REGION}-docker.pkg.dev/\${PROJECT_ID}/\${_REPO}/vlo:\${SHORT_SHA}
      - --region
      - \${_REGION}
      - --project
      - \${PROJECT_ID}

images:
  - \${_REGION}-docker.pkg.dev/\${PROJECT_ID}/\${_REPO}/vlo:\${SHORT_SHA}
  - \${_REGION}-docker.pkg.dev/\${PROJECT_ID}/\${_REPO}/vlo:latest

# Required when the trigger runs as a custom service account.
options:
  logging: CLOUD_LOGGING_ONLY
"
`;

exports[`vlo deploy > generates the cloud-run stack > cloud-run/cloudbuild-vlo.tf 1`] = `
"// Vlo deploy automation (Cloud Build triggers) — generated by
// \`vlo deploy --profile prod\`.
//
// Terraform ignores the service's container image (cloud-run-vlo.tf), so deploys happen
// here: per-env triggers watch main and run the generated cloudbuild.yaml
// (build → push → gcloud run deploy). Staging deploys automatically; prod waits for a
// manual approval in the Cloud Build console.
//
// ONE-TIME MANUAL PREREQUISITE: the GitHub repo must be connected to Cloud Build (install
// the Google Cloud Build GitHub App, then connect the repo under Cloud Build →
// Repositories, 1st gen). \`terraform apply\` fails with "repository mapping does not
// exist" until that is done. \`var.github_owner\` / \`var.github_repo\` are declared in
// cloudbuild-video-renderer.tf.

resource "google_artifact_registry_repository" "vlo" {
  project       = var.project_id
  location      = var.vlo_location
  repository_id = "vlo"
  description   = "Vlo host images (deployed via Cloud Build triggers)"
  format        = "DOCKER"

  depends_on = [google_project_service.artifactregistry]
}

// Dedicated deploy SA, so the blast radius of the pipeline is explicit.
resource "google_service_account" "vlo_deployer" {
  project      = var.project_id
  account_id   = "vlo-deployer"
  display_name = "Vlo deployer (Cloud Build)"
  description  = "Builds and deploys the Vlo host Cloud Run services"
}

resource "google_artifact_registry_repository_iam_member" "vlo_deployer_ar_writer" {
  project    = var.project_id
  location   = google_artifact_registry_repository.vlo.location
  repository = google_artifact_registry_repository.vlo.name
  role       = "roles/artifactregistry.writer"
  member     = "serviceAccount:\${google_service_account.vlo_deployer.email}"
}

resource "google_cloud_run_v2_service_iam_member" "vlo_deployer_run_developer" {
  for_each = local.vlo_envs

  project  = var.project_id
  location = var.vlo_location
  name     = google_cloud_run_v2_service.vlo[each.key].name
  role     = "roles/run.developer"
  member   = "serviceAccount:\${google_service_account.vlo_deployer.email}"
}

// Deploying a service that runs as the host SA requires actAs on it.
resource "google_service_account_iam_member" "vlo_deployer_act_as" {
  for_each = local.vlo_envs

  service_account_id = google_service_account.vlo[each.key].name
  role               = "roles/iam.serviceAccountUser"
  member             = "serviceAccount:\${google_service_account.vlo_deployer.email}"
}

// Custom-SA builds must write logs explicitly.
resource "google_project_iam_member" "vlo_deployer_log_writer" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:\${google_service_account.vlo_deployer.email}"
}

resource "google_cloudbuild_trigger" "vlo_deploy" {
  for_each = local.vlo_envs

  project     = var.project_id
  name        = "\${each.value.prefix}-vlo-deploy"
  description = "Build + deploy the Vlo host to \${each.key} on engine or workflow changes"
  location    = "global"

  github {
    owner = var.github_owner
    name  = var.github_repo
    push {
      branch = "^main$"
    }
  }

  included_files = ["packages/vlo/**", "src/**/vlo/**", "vlo.config.ts"]
  filename       = "deploy/vlo/cloud-run/cloudbuild.yaml"

  substitutions = {
    _SERVICE = google_cloud_run_v2_service.vlo[each.key].name
    _REGION  = var.vlo_location
    _REPO    = google_artifact_registry_repository.vlo.repository_id
  }

  service_account = google_service_account.vlo_deployer.id

  dynamic "approval_config" {
    for_each = each.key == "prod" ? [1] : []
    content {
      approval_required = true
    }
  }

  depends_on = [google_project_service.cloudbuild]
}
"
`;

exports[`vlo deploy > generates the vercel stack > vercel/env.md 1`] = `
"# Environment — \`prod\` on Vercel

Set every variable below on the Vercel project before the first deploy. Vlo reads them at
request time, so a change needs a redeploy only if the value is baked into a build.

| Variable | What it is |
| --- | --- |
| \`DATABASE_URL\` | Postgres journal. Pooled connection string — functions are short-lived. |
| \`VLO_TOKEN\` | Bearer token every control-plane route requires. The same value its clients hold. |
| \`VLO_PUSH_SECRET\` | HMAC secret shared with the workers this host pushes to and accepts callbacks from. |
| \`VLO_PUBLIC_URL\` | This deployment's own origin, e.g. \`https://example.com\`. Fills \`complete_url\` on a push. |
| \`VLO_QUEUE_LLM_URL\` | Push endpoint for the \`llm\` queue. |
| \`VLO_BUCKET\` | Bucket holding offloaded payloads and checkpoints. |
| \`GCP_SERVICE_ACCOUNT_KEY_BASE64\` | Base64 service-account JSON for the blob bucket. Only needed off Google infrastructure — on Cloud Run, ADC covers it. |

## Checks

- \`vlo doctor --profile prod\` with the same variables exported locally, before deploying.
- The cron in \`vercel-crons.json\` (\`* * * * *\`) is what advances timers, retries and task
  pushes. Without it, runs start and then sit still.
- Blob store: \`gcs\` · bucket \`orbi-prod-media\`.
"
`;

exports[`vlo deploy > generates the vercel stack > vercel/route.ts 1`] = `
"/**
 * Vlo control plane — generated by \`vlo deploy --profile prod\`.
 * Drop in at \`app/api/vlo/[[...path]]/route.ts\`.
 *
 * Roles: orchestrator, api. The dispatcher runs in \`manual\` mode because a
 * serverless function has no process to tick in — the cron in vercel-crons.json calls
 * POST /v1/timers/tick instead, and every tick does one full dispatcher pass.
 */

import { handler } from "@vlo/sdk/host";
// Globs cannot be bundled into a function, so the modules are imported explicitly.
// \`vlo deploy\` found these workflows: demo; re-export them from these two barrels.
import { workflows } from "@/vlo/workflows";
import { workers } from "@/vlo/workers";

// A tick and a long task push both need more than the default 10s.
export const maxDuration = 300;

function required(name: string): string {
  const value = process.env[name];
  if (value === undefined || value === "") throw new Error(\`vlo: \${name} is not set\`);
  return value;
}

export const { GET, POST } = handler({
  journal: required("DATABASE_URL"),
  blob: \`gcs://\${required("VLO_BUCKET")}/vlo\`,
  workflows,
  workers,
  roles: ["orchestrator", "api"],
  basePath: "/api/vlo",
  dispatcher: { mode: "manual" },
  queues: {
    llm: { url: required("VLO_QUEUE_LLM_URL"), secret: required("VLO_PUSH_SECRET") },
  },
  auth: { token: required("VLO_TOKEN"), pushSecret: required("VLO_PUSH_SECRET") },
  publicUrl: required("VLO_PUBLIC_URL"),
});
"
`;

exports[`vlo deploy > generates the vercel stack > vercel/vercel-crons.json 1`] = `
"{
  "crons": [
    {
      "path": "/api/vlo/v1/timers/tick",
      "schedule": "* * * * *"
    }
  ]
}
"
`;
