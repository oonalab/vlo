{
  "name": "vlo-workspace",
  "private": true,
  "description": "Workspace root for Vlo. The published package is sdk/ts/sdk (@oona/vlo).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "pnpm --filter @oona/vlo build",
    "test": "pnpm --filter @oona/vlo test",
    "typecheck": "pnpm -r typecheck",
    "docs:api": "pnpm --filter @oona/vlo docs:api",
    "check:links": "node scripts/check-links.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:publish": "./scripts/publish-docs.sh"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.15.0",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
