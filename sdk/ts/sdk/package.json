{
  "name": "@oona/vlo",
  "version": "0.1.1",
  "description": "Vlo: an event-sourced durable execution engine for workflows and agents. Workflows are pure reducers; the kernel is Rust compiled to wasm; your Postgres or SQLite is the journal.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oonalab/vlo.git",
    "directory": "sdk/ts/sdk"
  },
  "homepage": "https://oonalab.github.io/vlo/",
  "bugs": "https://github.com/oonalab/vlo/issues",
  "keywords": [
    "workflow",
    "durable-execution",
    "event-sourcing",
    "state-machine",
    "wasm",
    "agents",
    "postgres",
    "sqlite",
    "llm",
    "budget"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "vlo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "kernel:build": "../../../scripts/build-kernel.sh",
    "size": "node scripts/size-gate.mjs",
    "docs:api": "typedoc --options ../typedoc.json",
    "prepack": "cp ../../../LICENSE ../../../NOTICE ."
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "zod": "^4.0.0"
  }
}
