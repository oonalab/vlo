{
  "$schema": "https://typedoc.org/schema.json",
  "name": "TypeScript API",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "entryPointStrategy": "packages",
  "entryPoints": [
    "sdk"
  ],
  "out": "../../docs/api",
  "readme": "../../docs/.vitepress/api-index.md",
  "includeVersion": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "packageOptions": {
    "excludeInternal": true,
    "excludePrivate": true,
    "sourceLinkTemplate": "https://github.com/oonalab/vlo/blob/{gitRevision}/{path}#L{line}"
  },
  "docsRoot": "../../docs"
}
